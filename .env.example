# Copy to .env.local for local development. Never commit .env.local.
# Production values live on Vercel; see docs/API_SETUP.md.

# Upstash Redis (without these the app uses an in-memory store locally)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# random hex, for example: openssl rand -hex 32
SESSION_SECRET=
PLAYER_PEPPER=
ADMIN_TOKEN=
CRON_SECRET=

# the account that owns the contracts and pays players' fees (a test account)
RELAYER_PRIVATE_KEY=
GENLAYER_NETWORK=studionet

# contract addresses (lib/deployment.json is the fallback)
VERDICT_CONTRACT=
BRIDGE_CONTRACT=
ORACLE_CONTRACT=
LEDGER_CONTRACT=
REVIEW_CONTRACT=

NEXT_PUBLIC_EXPLORER=https://explorer-studio.genlayer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord application: https://discord.com/developers/applications
# Redirect: http://localhost:3000/api/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# optional: defaults to the GenLayer server
DISCORD_GUILD_ID=
# optional: 0 keeps Connect Discord optional
ARCADE_REQUIRE_DISCORD=

# optional: X handle verification through twitterapi.io
TWITTERAPI_KEY=
