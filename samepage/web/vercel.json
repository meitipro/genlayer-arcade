{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/p/:id/record", "destination": "/record.html" },
    { "source": "/p/:id", "destination": "/p.html" }
  ]
}
