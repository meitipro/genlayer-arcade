{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd samepage/web && npm ci --no-audit --no-fund",
  "buildCommand": "node samepage/scripts/vercel-guard.mjs && cd samepage/web && npm run build",
  "outputDirectory": "samepage/web/out",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/p/:id/record", "destination": "/record.html" },
    { "source": "/p/:id", "destination": "/p.html" }
  ]
}
